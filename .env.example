# =================================
# TONIC — Environment Configuration
# =================================

# Development
VITE_API_URL=http://localhost:3001
VITE_APP_NAME=tonic

# Server
PORT=3001
NODE_ENV=development

# AI API — Anthropic (for Score → iReal Pro feature)
# Get your API key from: https://console.anthropic.com/
AI_API_KEY=your_anthropic_api_key_here
AI_API_PROVIDER=anthropic

# ─── AI endpoint protection (server-side only — never prefix with VITE_) ──────
# The AI endpoints require a signed-in Firebase user and count a daily quota.
# Service account: Firebase console → Impostazioni progetto → Account di servizio
# → Genera nuova chiave privata. Copy these 3 fields from the JSON.
# On Netlify, scope them to "Functions" only. Keep the private key on one line with \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Daily calls per user (UTC day). Defaults: buddy 30, score 5.
AI_DAILY_LIMIT_BUDDY=30
AI_DAILY_LIMIT_SCORE=5
# Extra allowed origins, comma-separated (the Netlify site URL is added automatically).
ALLOWED_ORIGINS=
# Local dev only: skip auth + quota when you have no service account.
# Ignored on the Netlify production context.
AI_AUTH_DISABLED=false

# ─── Firebase ──────────────────────────────────────────────────────────────────
# Progetto esistente: "Tonic" (tonic-7a5eb) — vedi .firebaserc. Non crearne un altro.
# Config web: console Firebase → Impostazioni progetto (⚙) → Le tue app → app web → Copia config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Feature Flags (optional)
VITE_ENABLE_AI_VOICINGS=false
VITE_ENABLE_SCALE_RECOGNITION=false