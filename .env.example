# =================================
# TONIC — Environment Configuration
# =================================

# Development
VITE_API_URL=http://localhost:3001
VITE_APP_NAME=tonic

# Server
PORT=3001
NODE_ENV=development

# AI API — Anthropic (for Score → iReal Pro feature)
# Get your API key from: https://console.anthropic.com/
AI_API_KEY=your_anthropic_api_key_here
AI_API_PROVIDER=anthropic

# ─── AI endpoint protection (server-side only — never prefix with VITE_) ──────
# The AI endpoints require a signed-in Firebase user and count a daily quota.
# Service account: Firebase console → Impostazioni progetto → Account di servizio
# → Genera nuova chiave privata. Copy these 3 fields from the JSON.
# On Netlify, scope them to "Functions" only. Keep the private key on one line with \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Daily AI calls per user (UTC day), by plan. Defaults shown.
AI_DAILY_LIMIT_FREE_BUDDY=5
AI_DAILY_LIMIT_FREE_SCORE=0
AI_DAILY_LIMIT_PRO_BUDDY=100
AI_DAILY_LIMIT_PRO_SCORE=10
# Extra allowed origins, comma-separated (the Netlify site URL is added automatically).
ALLOWED_ORIGINS=
# Local dev only: skip auth + quota when you have no service account.
# Ignored on the Netlify production context.
AI_AUTH_DISABLED=false

# ─── Firebase ──────────────────────────────────────────────────────────────────
# Progetto esistente: "Tonic" (tonic-7a5eb) — vedi .firebaserc. Non crearne un altro.
# Config web: console Firebase → Impostazioni progetto (⚙) → Le tue app → app web → Copia config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Error monitoring (optional) ──────────────────────────────────────────────
# Sentry → Project settings → Client Keys (DSN). Prefer an EU (de.sentry.io) org.
VITE_SENTRY_DSN=

# ─── Legal documents (Iubenda) ───────────────────────────────────────────────
# Iubenda dashboard → your site → Privacy and Cookie Policy / Terms and Conditions
# → "Integra" → copy the direct link of each document.
VITE_PRIVACY_POLICY_URL=
VITE_COOKIE_POLICY_URL=
VITE_TERMS_URL=

# ─── Subscriptions (Paddle Billing) ──────────────────────────────────────────
# Leave empty to run without billing: every tool unlocked (beta / local dev).
# Paddle → Developer tools → Authentication. Use sandbox keys until launch.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
# Developer tools → Notifications → destination /api/paddle-webhook (subscription.*)
PADDLE_WEBHOOK_SECRET=
# Catalog → Products → tonic Pro → prices (with a 7-day trial)
PADDLE_PRICE_MONTHLY=
PADDLE_PRICE_YEARLY=
# Client side (public): Developer tools → Authentication → client-side token
VITE_PADDLE_ENV=sandbox
VITE_PADDLE_CLIENT_TOKEN=
