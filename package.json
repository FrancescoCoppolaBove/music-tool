{
  "name": "music-tool",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:transcription": "node scripts/prepare-transcription-assets.mjs",
    "predev:client": "npm run prepare:transcription",
    "prebuild": "npm run prepare:transcription",
    "test:transcriber": "node --import tsx --test src/features/audio-transcriber/engine/*.test.ts",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/api/server.ts",
    "build": "tsc && vite build",
    "build:netlify": "npm run build",
    "preview": "vite preview",
    "test:theory": "node --import tsx --test src/features/harmony-composition-lab/*.test.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test:guard": "node --import tsx --test tests/aiGuard.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tonic 'node --import tsx --test tests/firestore-rules.test.ts'",
    "test:account": "firebase emulators:exec --only firestore,auth --project demo-tonic 'node --import tsx --test tests/account.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@spotify/basic-pitch": "1.0.1",
    "@tensorflow/tfjs": "3.21.0",
    "@tensorflow/tfjs-backend-wasm": "3.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.560.0",
    "pitchy": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tonal": "^6.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@netlify/functions": "^3.1.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-tools": "^14.27.0",
    "tsx": "^4.7.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.11"
  }
}
